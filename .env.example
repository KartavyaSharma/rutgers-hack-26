# Copy to .env at the repo root and fill in. Everything is optional for local dev:
# without keys, buttons and staff screens still work, typed requests go to the nurse,
# and the talk button is disabled.

# LiveKit (voice). Cloud project URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text. Default: Microsoft MAI-Transcribe-2 through the Vercel AI Gateway (auto language
# detection), used when AI_GATEWAY_API_KEY is set. Fallback: Deepgram Flux (10 languages).
AI_GATEWAY_API_KEY=
# STT_PROVIDER=mai        # mai | deepgram
# Background voice cancellation (LiveKit Cloud, Krisp BVC) on the agent's input: bvc (default) | off
# NOISE_CANCELLATION=bvc
DEEPGRAM_API_KEY=

# Request classifier: Jev by TypeSafe AI (team, clinical, urgency). Without it, typed and spoken
# requests become nurse drafts.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Conversation LLM for the voice agent (Cerebras, OpenAI-compatible). Also the backup Qwen router.
CEREBRAS_API_KEY=
# CEREBRAS_AGENT_MODEL=qwen-3.8-27b
# CEREBRAS_AGENT_REASONING_EFFORT=low   # none | minimal | low | medium | high

# Text to speech (ElevenLabs)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# eleven_v4_turbo (low latency, built for live agents) or eleven_v4 (higher quality, slower)
ELEVEN_MODEL=eleven_v4_turbo

# Postgres. Leave empty to use PGlite in ./.data (no Docker needed).
DATABASE_URL=

# Where the web app is reachable (the agent posts requests here)
APP_URL=http://localhost:3000

# Shared secret the agent uses to create routed requests through the web API
AGENT_SHARED_SECRET=change-me-dev-secret
