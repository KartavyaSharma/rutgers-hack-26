# Copy to .env at the repo root and fill in. Everything is optional for local dev:
# without keys, buttons and staff screens still work, typed requests go to the nurse,
# and the talk button is disabled.

# LiveKit (voice). Cloud project URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text (Deepgram Flux)
DEEPGRAM_API_KEY=

# Router LLM (Cerebras, OpenAI-compatible)
CEREBRAS_API_KEY=

# Text to speech (ElevenLabs)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# eleven_v4_turbo (low latency, built for live agents) or eleven_v4 (higher quality, slower)
ELEVEN_MODEL=eleven_v4_turbo

# Postgres. Leave empty to use PGlite in ./.data (no Docker needed).
DATABASE_URL=

# Where the web app is reachable (the agent posts requests here)
APP_URL=http://localhost:3000

# Shared secret the agent uses to create routed requests through the web API
AGENT_SHARED_SECRET=change-me-dev-secret
