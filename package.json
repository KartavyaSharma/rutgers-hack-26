{
  "name": "bell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bell/web --filter @bell/agent dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.18.0",
    "typescript": "6.0.3"
  }
}
